// Trommel: allow a local user to run the narrow GPU helper without a password
// prompt. The helper itself validates the GPU UUID and numeric ranges.
//
// This is the generic fallback. The Debian postinst also writes a per-user
// rule to /etc/polkit-1/rules.d/50-trommel.rules for the user who installed
// the package (SUDO_USER), which is stricter and takes precedence.
polkit.addRule(function (action, subject) {
    if (action.id !== "io.github.nayvok.trommel.oc") {
        return polkit.Result.NOT_HANDLED;
    }
    if (!subject.local) {
        return polkit.Result.NOT_HANDLED;
    }
    return polkit.Result.YES;
});
