#!/bin/sh
set -e

# Remove the per-user rule generated by postinst. Keep it on upgrade.
if [ "${1:-}" = "remove" ] || [ "${1:-}" = "purge" ]; then
    rm -f /etc/polkit-1/rules.d/50-trommel.rules
    if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
        case "$SUDO_USER" in
            *[!a-zA-Z0-9._-]*) ;;
            *)
                if getent passwd "$SUDO_USER" >/dev/null 2>&1; then
                    user_home=$(getent passwd "$SUDO_USER" | cut -d: -f6)
                    if [ -n "$user_home" ]; then
                        rm -f "$user_home/.config/systemd/user/graphical-session.target.wants/trommeld.service"
                    fi
                fi
                ;;
        esac
    fi
fi

exit 0
