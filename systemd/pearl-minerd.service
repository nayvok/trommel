[Unit]
Description=Pearl Miner: фоновый сервис (D-Bus org.pearl.Miner.Daemon)
Documentation=file://%h/pearl/pearl-miner/README.md
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=org.pearl.Miner.Daemon
ExecStart=%h/.local/bin/pearl-minerd
Restart=on-failure
RestartSec=3
# Майнеру нужен доступ к GPU и к сети.
Slice=background.slice
Nice=5
IOWeight=50

[Install]
WantedBy=graphical-session.target
