#!/bin/bash
# trommel-oc — narrow root helper for NVIDIA power/clocks (Trommel).
#
# Installed at /usr/libexec/trommel/trommel-oc and invoked through pkexec:
#   pkexec /usr/libexec/trommel/trommel-oc apply --gpu GPU-... --pl 300 --lgc 1620 --lmc 810
#   pkexec /usr/libexec/trommel/trommel-oc reset --gpu GPU-... --pl 350
#
# Only a GPU UUID and numeric values in strict ranges are accepted. No paths,
# shell metacharacters or arbitrary commands can pass through.
set -euo pipefail
export LC_ALL=C
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

NVIDIA_SMI=/usr/bin/nvidia-smi

die() { echo "trommel-oc: $*" >&2; exit 1; }
usage() {
    cat >&2 <<'USAGE'
usage:
  trommel-oc apply --gpu GPU-UUID [--pl W] [--lgc MHz] [--lmc MHz]
  trommel-oc reset --gpu GPU-UUID [--pl W]
  trommel-oc status --gpu GPU-UUID

The optional --lease-pid PID --lease-start START pair names the daemon that
queued the change. The helper aborts if that process (matched by /proc field
22) is gone, so a request queued before a crash can not tune a restored rig.
USAGE
    exit 2
}

[ "$(id -u)" -eq 0 ] || die "root is required (run through pkexec)"
[ -x "$NVIDIA_SMI" ] || die "nvidia-smi not found"

valid_uuid() {
    [[ "$1" =~ ^GPU-[0-9a-fA-F-]{8,64}$ ]]
}

num() {
    local value=$1 flag=$2 min=$3 max=$4
    [[ $value =~ ^[0-9]{1,5}$ ]] || die "$flag: «$value» is not a number"
    (( value >= min && value <= max )) || die "$flag: $value outside $min..$max"
}

LEASE_PID=""
LEASE_START=""

lease_number() {
    local value=$1 flag=$2 digits=$3 max=$4
    [[ $value =~ ^[0-9]{1,20}$ ]] || die "$flag: «$value» is not a number"
    (( ${#value} <= digits )) || die "$flag: $value is too long"
    (( value >= 1 && value <= max )) || die "$flag: $value outside 1..$max"
}

# Reject a request whose daemon died while it was queued behind polkit. The
# start time catches PID reuse; a missing /proc entry catches a SIGKILL.
check_lease() {
    [ -z "$LEASE_PID" ] && [ -z "$LEASE_START" ] && return 0
    [ -n "$LEASE_PID" ] && [ -n "$LEASE_START" ] \
        || die "lease flags must be passed together"
    [ -r "/proc/$LEASE_PID/stat" ] \
        || die "lease process $LEASE_PID is gone; refusing to change the GPU"
    local stat rest start
    stat=$(<"/proc/$LEASE_PID/stat")
    rest=${stat##*') '}
    start=$(echo "$rest" | awk '{print $20}')
    [ "$start" = "$LEASE_START" ] \
        || die "lease process $LEASE_PID was replaced; refusing to change the GPU"
}

power_limit() {
    local uuid=$1 value
    value=$("$NVIDIA_SMI" --query-gpu=power.limit --format=csv,noheader,nounits -i "$uuid" 2>/dev/null || true)
    value=${value%%.*}
    value=${value//[^0-9]/}
    echo "${value:-0}"
}

# Wait until the driver reports the requested power limit. The old version
# always returned 0, so a clamped/ignored limit was reported as success. This
# is the one target that can be verified even on an idle card.
wait_for_pl() {
    local uuid=$1 want=$2 current
    for _ in $(seq 1 20); do
        current=$(power_limit "$uuid")
        if [ "$current" -eq "$want" ]; then
            return 0
        fi
        sleep 0.15
    done
    return 1
}

apply() {
    local uuid=""
    local pl="" lgc="" lmc=""
    local applied=0
    while [ $# -gt 0 ]; do
        case $1 in
            --gpu)
                [ $# -ge 2 ] || die "--gpu: missing value"
                valid_uuid "$2" || die "--gpu: invalid UUID"
                uuid=$2
                shift 2
                ;;
            --pl)
                [ $# -ge 2 ] || die "--pl: missing value"
                num "$2" --pl 50 1000
                [ -n "$uuid" ] || die "--gpu must come before --pl"
                pl=$2
                applied=1
                shift 2
                ;;
            --lgc)
                [ $# -ge 2 ] || die "--lgc: missing value"
                num "$2" --lgc 100 4000
                [ -n "$uuid" ] || die "--gpu must come before --lgc"
                lgc=$2
                applied=1
                shift 2
                ;;
            --lmc)
                [ $# -ge 2 ] || die "--lmc: missing value"
                num "$2" --lmc 100 12000
                [ -n "$uuid" ] || die "--gpu must come before --lmc"
                lmc=$2
                applied=1
                shift 2
                ;;
            --lease-pid)
                [ $# -ge 2 ] || die "--lease-pid: missing value"
                lease_number "$2" --lease-pid 7 4194304
                LEASE_PID=$2
                shift 2
                ;;
            --lease-start)
                [ $# -ge 2 ] || die "--lease-start: missing value"
                lease_number "$2" --lease-start 18 999999999999999999
                LEASE_START=$2
                shift 2
                ;;
            *)
                die "unknown flag: $1"
                ;;
        esac
    done
    [ -n "$uuid" ] || die "--gpu <uuid> is required"
    [ "$applied" -eq 1 ] || die "at least one tuning parameter is required"
    check_lease

    if [ -n "$pl" ]; then
        "$NVIDIA_SMI" -i "$uuid" -pl "$pl" >/dev/null || die "nvidia-smi -pl $pl failed"
        wait_for_pl "$uuid" "$pl" \
            || die "nvidia-smi -pl $pl did not take effect (driver reports $(power_limit "$uuid") W)"
    fi
    if [ -n "$lgc" ]; then
        "$NVIDIA_SMI" -i "$uuid" -lgc "$lgc,$lgc" >/dev/null || die "nvidia-smi -lgc $lgc failed"
    fi
    if [ -n "$lmc" ]; then
        "$NVIDIA_SMI" -i "$uuid" -lmc "$lmc" >/dev/null || die "nvidia-smi -lmc $lmc failed"
    fi
    echo "apply ok pl=${pl:-none} lgc=${lgc:-none} lmc=${lmc:-none}"
}

reset() {
    local uuid=""
    local pl=""
    while [ $# -gt 0 ]; do
        case $1 in
            --gpu)
                [ $# -ge 2 ] || die "--gpu: missing value"
                valid_uuid "$2" || die "--gpu: invalid UUID"
                uuid=$2
                shift 2
                ;;
            --pl)
                [ $# -ge 2 ] || die "--pl: missing value"
                num "$2" --pl 50 1000
                pl=$2
                shift 2
                ;;
            --lease-pid)
                [ $# -ge 2 ] || die "--lease-pid: missing value"
                lease_number "$2" --lease-pid 7 4194304
                LEASE_PID=$2
                shift 2
                ;;
            --lease-start)
                [ $# -ge 2 ] || die "--lease-start: missing value"
                lease_number "$2" --lease-start 18 999999999999999999
                LEASE_START=$2
                shift 2
                ;;
            *)
                die "unknown flag: $1"
                ;;
        esac
    done
    [ -n "$uuid" ] || die "--gpu <uuid> is required"
    check_lease

    # Reset both clock domains and report a failure instead of claiming the
    # stock state was restored. A card where -rgc/-rmc is unsupported should
    # fail loudly; silently leaving a lock is worse.
    local gc_err="" mc_err=""
    gc_err=$("$NVIDIA_SMI" -i "$uuid" -rgc 2>&1 >/dev/null) \
        || die "nvidia-smi -rgc failed: ${gc_err:-unknown error}"
    mc_err=$("$NVIDIA_SMI" -i "$uuid" -rmc 2>&1 >/dev/null) \
        || die "nvidia-smi -rmc failed: ${mc_err:-unknown error}"
    if [ -n "$pl" ]; then
        "$NVIDIA_SMI" -i "$uuid" -pl "$pl" >/dev/null || die "nvidia-smi -pl $pl failed"
        wait_for_pl "$uuid" "$pl" \
            || die "nvidia-smi -pl $pl did not take effect (driver reports $(power_limit "$uuid") W)"
    fi
    echo "reset ok pl=${pl:-none}"
}

command=${1:-}
[ $# -gt 0 ] && shift
case $command in
    apply) apply "$@" ;;
    reset) reset "$@" ;;
    status)
        [ $# -eq 2 ] && [ "$1" = "--gpu" ] || usage
        valid_uuid "$2" || die "invalid UUID"
        "$NVIDIA_SMI" -i "$2" -q -d CLOCK,POWER,TEMPERATURE | head -60
        ;;
    *) usage ;;
esac
