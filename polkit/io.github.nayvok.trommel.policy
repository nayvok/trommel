<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Trommel</vendor>
  <vendor_url>https://github.com/nayvok/trommel</vendor_url>

  <action id="io.github.nayvok.trommel.oc">
    <description>Change GPU power and clocks for mining</description>
    <description xml:lang="ru">Изменение питания и частот GPU для майнинга</description>
    <message>Apply GPU power and clock settings</message>
    <message xml:lang="ru">Применить настройки питания и частот видеокарты</message>

    <!-- Details of the helper that is allowed to run. -->
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>

    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/trommel/trommel-oc</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
