{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nayvok/trommel/docs/schema/config.schema.json",
  "title": "Trommel config v4",
  "type": "object",
  "required": [
    "schema_version",
    "presets",
    "gpu_presets",
    "miner_installs",
    "behavior"
  ],
  "properties": {
    "schema_version": {"const": 4},
    "active_preset": {"type": ["string", "null"]},
    "presets": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/preset"}
    },
    "gpu_presets": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/gpuPreset"}
    },
    "miner_installs": {"type": "object"},
    "behavior": {
      "type": "object",
      "required": [
        "auto_restart",
        "restart_delay_s",
        "poll_interval_s",
        "restore_stock_on_stop",
        "notifications",
        "language"
      ],
      "properties": {
        "auto_restart": {"type": "boolean"},
        "restart_delay_s": {"type": "integer", "minimum": 1},
        "poll_interval_s": {"type": "integer", "minimum": 1, "maximum": 60},
        "restore_stock_on_stop": {"type": "boolean", "default": true},
        "start_mining_on_login": {"type": "boolean"},
        "notifications": {"type": "boolean"},
        "tray_monochrome": {
          "type": "boolean",
          "default": true,
          "description": "Use the monochrome symbolic icon in the status tray"
        },
        "language": {"enum": ["system", "en", "ru"]},
        "appearance": {"enum": ["system", "light", "dark"]},
        "simple_mode": {"type": "boolean"},
        "temp_limit_c": {"type": "integer", "minimum": 60, "maximum": 100},
        "temp_resume_c": {"type": "integer", "minimum": 40, "maximum": 95},
        "watchdog_enabled": {"type": "boolean", "default": false},
        "watchdog_threshold_pct": {"type": "integer", "minimum": 10, "maximum": 100, "default": 80},
        "watchdog_window_s": {"type": "integer", "minimum": 60, "maximum": 3600, "default": 300},
        "watchdog_action": {"enum": ["notify", "restart"], "default": "notify"},
        "watchdog_max_restarts": {"type": "integer", "minimum": 1, "maximum": 10, "default": 3}
      }
    }
  },
  "$defs": {
    "gpuTuning": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "false = exclude this card from the preset's mining session",
          "default": true
        },
        "power_limit_w": {"type": ["integer", "null"], "minimum": 50, "maximum": 1000},
        "core_clock_mhz": {"type": ["integer", "null"], "minimum": 0, "maximum": 4000},
        "memory_clock_mhz": {"type": ["integer", "null"], "minimum": 0, "maximum": 12000},
        "custom": {
          "type": "boolean",
          "description": "true = explicit per-card regime; false = inherit the profile default"
        },
        "gpu_preset": {
          "type": "string",
          "description": "Metadata: id of the named GpuPreset this card follows"
        }
      },
      "additionalProperties": true
    },
    "gpuProfile": {
      "type": "object",
      "required": ["default"],
      "properties": {
        "default": {"$ref": "#/$defs/gpuTuning"},
        "per_gpu": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/gpuTuning"}
        }
      },
      "additionalProperties": false
    },
    "preset": {
      "type": "object",
      "required": [
        "id",
        "name",
        "coin",
        "algo",
        "miner",
        "miner_version",
        "pool_url",
        "gpu"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "coin": {"type": "string"},
        "coin_symbol": {"type": "string"},
        "coin_name": {"type": "string"},
        "wallet_prefix": {"type": "string"},
        "hashrate_unit": {
          "enum": ["auto", "H/s", "kH/s", "MH/s", "GH/s", "TH/s", "PH/s"]
        },
        "algo": {"type": "string"},
        "miner": {"type": "string"},
        "miner_version": {"type": "string"},
        "pool_url": {"type": "string"},
        "pool_fee_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "pool_api_url": {"type": "string"},
        "wallet": {"type": "string"},
        "worker": {"type": "string"},
        "gpu": {"$ref": "#/$defs/gpuProfile"},
        "api_port": {"type": "integer", "minimum": 0, "maximum": 65535},
        "expected_hashrate": {"type": ["number", "null"]},
        "miner_options": {"type": "object"},
        "miner_fee_override_pct": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "miner_fee_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "extra_args": {"type": "string"},
        "env": {"type": "object", "additionalProperties": {"type": "string"}},
        "created_at": {"type": "integer", "minimum": 0},
        "updated_at": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "gpuPreset": {
      "type": "object",
      "required": ["id", "name", "gpu_uuid", "gpu_name", "tuning"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "gpu_uuid": {"type": "string"},
        "gpu_name": {"type": "string"},
        "tuning": {"$ref": "#/$defs/gpuTuning"},
        "created_at": {"type": "integer", "minimum": 0},
        "updated_at": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
